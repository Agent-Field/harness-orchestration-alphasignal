# --- AgentField control plane -------------------------------------------
# Local dev (make up / af service): the control plane listens on :8080.
# Under docker compose the node reaches it by service DNS name instead:
#   AGENTFIELD_SERVER=http://control-plane:8080
AGENTFIELD_SERVER=http://localhost:8080

# --- Model access -------------------------------------------------------
# One key covers every model in the repo.  https://openrouter.ai/keys
# In 0.1.132 AIConfig has NO openrouter_api_key field -- the SDK reads this
# env var directly. Setting it here is the only supported path.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Default model for every chapter.
#
# The "openrouter/" prefix is a LiteLLM provider prefix and is REQUIRED.
#
# VERIFIED 2026-08-20 with litellm 1.96.2 (the SDK's LLM layer):
#   litellm.get_llm_provider("openrouter/deepseek/deepseek-v4-flash") -> "openrouter"
#   litellm.get_llm_provider("deepseek/deepseek-v4-flash")            -> "deepseek"
#
# So the bare slug does NOT fail loudly -- it silently routes to DeepSeek's
# DIRECT API instead of OpenRouter. If you happen to have DEEPSEEK_API_KEY set
# it even appears to work, and you never notice you left OpenRouter. If you
# don't, you get an authentication error naming a provider you never chose.
# Keep the prefix.
#
# Also: "deepseek/deepseek-v4-flash-latest" is not a callable model id at all.
# OpenRouter returns 400 "not a valid model ID" -- it is an alias row in the
# /models listing, not a slug you can send.
AI_MODEL=openrouter/deepseek/deepseek-v4-flash

# DeepSeek V4 Flash is a REASONING model: reasoning tokens are spent before
# any content is emitted, so a small max_tokens silently truncates structured
# output into a parse failure. Keep this >= 2000.
AI_MAX_TOKENS=2000

# --- Harness (optional) -------------------------------------------------
# app.harness() runs AForge, which ships with `af` and needs no model slug at
# all -- just OPENROUTER_API_KEY above. It is the zero-config path when you do
# not care which model does the work. AFORGE_MODEL overrides it.
# AFORGE_MODEL=openrouter/deepseek/deepseek-v4-flash
