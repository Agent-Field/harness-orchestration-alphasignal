# --- AgentField control plane -------------------------------------------
# Local dev (make up / af service): the control plane listens on :8080.
# Under docker compose the node reaches it by service DNS name instead:
#   AGENTFIELD_SERVER=http://control-plane:8080
AGENTFIELD_SERVER=http://localhost:8080

# --- Model access -------------------------------------------------------
# One key covers every model in the repo.  https://openrouter.ai/keys
# In 0.1.132 AIConfig has NO openrouter_api_key field -- the SDK reads this
# env var directly. Setting it here is the only supported path.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Default model for every chapter.
#
# The "openrouter/" prefix is a LiteLLM provider prefix and is REQUIRED.
# The bare OpenRouter slug "deepseek/deepseek-v4-flash" will not route.
#
# Verified live against https://openrouter.ai/api/v1/models on 2026-08-20.
# Do NOT use "deepseek/deepseek-v4-flash-latest": OpenRouter rejects it with
# 400 "not a valid model ID". It is an alias row, not a callable slug.
AI_MODEL=openrouter/deepseek/deepseek-v4-flash

# DeepSeek V4 Flash is a REASONING model: reasoning tokens are spent before
# any content is emitted, so a small max_tokens silently truncates structured
# output into a parse failure. Keep this >= 2000.
AI_MAX_TOKENS=2000
